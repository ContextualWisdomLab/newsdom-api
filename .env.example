# Production and shared environments use the fail-closed authentication mode.
NEWSDOM_AUTH_MODE=required
NEWSDOM_RUNTIME_PROFILE=production
# Generate a high-entropy token in the deployment secret store. Never commit it.
NEWSDOM_API_TOKEN=
# Per-process non-waiting parser admission budget. Scale replicas separately.
NEWSDOM_MAX_CONCURRENT_PARSES=1
# Optional API-only image override for a bundled or mounted MinerU executable.
# NEWSDOM_MINERU_BIN=/opt/mineru/bin/mineru
