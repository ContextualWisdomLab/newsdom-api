{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsdom.local/benchmarks/upload-ingestion-result.schema.json",
  "title": "UploadIngestionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selects_production_chunk",
    "rollback_chunk_bytes",
    "cases"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "selects_production_chunk": { "type": "boolean", "const": false },
    "rollback_chunk_bytes": { "type": "integer", "const": 8192 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_bytes",
          "concurrency",
          "fixture_bytes",
          "fixture_sha256",
          "read_calls",
          "elapsed_seconds",
          "peak_vmrss_kib"
        ],
        "properties": {
          "chunk_bytes": { "type": "integer", "minimum": 1 },
          "concurrency": { "type": "integer", "minimum": 1 },
          "fixture_bytes": { "type": "integer", "minimum": 1 },
          "fixture_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "read_calls": { "type": "integer", "minimum": 1 },
          "elapsed_seconds": { "type": "number", "minimum": 0 },
          "peak_vmrss_kib": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
