FROM python:3.10-slim

ENV UV_VERSION=0.11.3

# Install system dependencies
# @coderabbitai ignore
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pin to match .github/workflows/tests.yml)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /app

# Pre-warm dependencies only (source is mounted at runtime by Actions)
COPY pyproject.toml README.md ./
COPY src/newsdom_api/__init__.py ./src/newsdom_api/__init__.py

# Install dependencies using uv
# Install to system Python so that it's accessible without activating a venv
RUN uv pip install --system -e ".[dev]"

ENV PYTHONPATH=/app/src

# Run as an unprivileged user (Trivy DS-0002). Dependencies are installed into
# system Python above, so no privileged access is needed at runtime; the mounted
# source is only read, and pytest writes its cache/coverage under /app which the
# user owns.
#
# NOTE: If this image is ever consumed by a GitHub Actions `container:` job, the
# runner bind-mounts root-owned workspace/temp dirs. Override the user there with
# `container: { options: --user root }` rather than reverting this Dockerfile.
RUN groupadd --system ciuser \
    && useradd --system --create-home --home-dir /home/ciuser --gid ciuser --shell /usr/sbin/nologin ciuser \
    && chown -R ciuser:ciuser /app
USER ciuser

# Minimal liveness check for the misconfig scanner (Trivy DS-0026). This is a
# short-lived test image with no long-running service, so a lightweight import
# smoke test is sufficient.
HEALTHCHECK CMD ["python", "-c", "import sys; sys.exit(0)"]

CMD ["pytest"]
